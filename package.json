{
  "name": "plainballot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "research": "node --env-file-if-exists=.env.local --import tsx scripts/research.ts",
    "eval": "node --env-file-if-exists=.env.local --import tsx scripts/eval-interpret.ts",
    "check:research": "node --import tsx scripts/check-positions.ts",
    "review": "node --import tsx scripts/review-sheet.ts",
    "recheck": "node --env-file-if-exists=.env.local --import tsx scripts/recheck.ts",
    "research:state": "node --env-file-if-exists=.env.local --import tsx scripts/research-state.ts",
    "compare-models": "node --env-file-if-exists=.env.local --import tsx scripts/compare-models.ts",
    "ca:list": "node --import tsx scripts/ca-cert-list.ts",
    "consensus": "node --env-file-if-exists=.env.local --import tsx scripts/consensus.ts",
    "research:queue": "node --env-file-if-exists=.env.local --import tsx scripts/research-queue.ts",
    "bias-check": "node --env-file-if-exists=.env.local --import tsx scripts/bias-check.ts",
    "schema": "node --import tsx scripts/positions-schema.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.113",
    "botid": "^1.5.11",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "license": "AGPL-3.0",
  "description": "Every race on your ballot, matched to what you care about, with a verified source for every claim.",
  "homepage": "https://plainballot.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n8peace/plainballot.git"
  },
  "bugs": {
    "url": "https://github.com/n8peace/plainballot/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "voting",
    "elections",
    "ballot",
    "civic-tech",
    "nextjs",
    "ai"
  ]
}
