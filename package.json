{
  "name": "plainballot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && seolint",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "eval": "node --env-file-if-exists=.env.local --import tsx scripts/eval-interpret.ts",
    "bias-check": "node --env-file-if-exists=.env.local --import tsx scripts/bias-check.ts",
    "check:issues": "node --import tsx scripts/check-issues.ts",
    "indexnow": "node --import tsx scripts/indexnow.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.162",
    "botid": "^1.5.12",
    "mcp-handler": "^2.3.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "seolint": "1.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "license": "AGPL-3.0",
  "description": "Plain Ballot: a free, nonpartisan voter guide that matches every race on your ballot to your priorities, built on the open Open Election Data.",
  "homepage": "https://plainballot.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n8peace/plainballot.git"
  },
  "bugs": {
    "url": "https://github.com/n8peace/plainballot/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "voting",
    "elections",
    "ballot",
    "civic-tech",
    "nextjs",
    "ai"
  ]
}
