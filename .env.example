# Copy to .env.local for local development. In production, set these in Vercel.

# Required for "In your own words".
# Vercel dashboard → AI Gateway → API Keys → Create key.
AI_GATEWAY_API_KEY=

# Optional: live ballot lookup by address. Without it the site shows a sample ballot.
# Google Cloud Console → enable "Google Civic Information API" → Credentials → API key.
GOOGLE_CIVIC_API_KEY=
# Pin the election (12000 = 2026 General Midterm; IDs from the Civic API /elections endpoint).
GOOGLE_CIVIC_ELECTION_ID=12000

# Optional: better address suggestions (Google Places API (New), needs billing on the Google project).
# Without it, suggestions come from OpenStreetMap (free, weaker on house numbers).
GOOGLE_PLACES_API_KEY=

# Optional overrides.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
INTERPRET_MODEL=anthropic/claude-haiku-4.5

# Researched races come from the Open Election Data API. To work offline,
# point ELECTION_DATA_DIR at a local checkout's data/positions folder instead.
# ELECTION_DATA_URL=https://n8peace.github.io/open-election-data/v1
# ELECTION_DATA_DIR=../open-election-data/data/positions
